<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM0G5187"
            />
        </when>
    </applicability>

    <project
        title="dynamic_hand_gesture_recognition_ai"
        name="dynamic_hand_gesture_recognition_ai_LP_MSPM0G5187_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM0G5187"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -DDEVICE_NAME=MSPM0G5187
            -DARM_MATH_CM0
            @device.opt
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/DSP/Include
            -Iexamples/edgeAI/dynamic_hand_gesture_recognition_ai/comm
            -Iexamples/edgeAI/dynamic_hand_gesture_recognition_ai/sensors
            -Iexamples/edgeAI/dynamic_hand_gesture_recognition_ai/imu
            -I${PROJECT_ROOT}/comm
            -I${PROJECT_ROOT}/sensors
            -I${PROJECT_ROOT}/sensors/imu
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/edgeAI/feature_extract
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
            -Wall
        "
        linkerBuildOptions="
            -lmodel/model.a
            -ldevice.cmd.genlibs
            -L${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM0_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Example to recognize hand gestures using accelerometer sensor on TIDA-010997 boosterpack and MSPM0G5187 LaunchPad">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../dynamic_hand_gesture_recognition_ai.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../comm/spi_comm.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../comm/spi_comm.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../sensors/sensor.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors">
        </file>
        <file path="../sensors/sensor.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors">
        </file>
        <file path="../sensors/imu/sensor_BMI270.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/imu">
        </file>
        <file path="../sensors/imu/sensor_BMI270.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/imu">
        </file>
        <file path="../model/tvmgen_default.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="model">
        </file>
        <file path="../model/user_input_config.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="model">
        </file>
        <file path="../model/model.a" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="model">
        </file>
        <file path="../README.md" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
        <file path="../README.html" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../dynamic_hand_gesture_recognition_ai.syscfg" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>